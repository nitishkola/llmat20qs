#!/bin/bash
#SBATCH --job-name=20q-tesla1
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=00-08:00
#SBATCH --mem=30000
#SBATCH --cpus-per-task=4
#SBATCH --nodelist=tesla1
#SBATCH --gres=gpu:2

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

module load pytorch-cuda12
source "$HOME/.venvs/llmat20qs/bin/activate"

echo "Job started on $(hostname) at $(date)"
nvidia-smi
python -c 'import torch; assert torch.cuda.is_available(), "SLURM did not expose a GPU"; print(torch.cuda.get_device_name(0))'

GPU_LOG="logs/gpu_usage-${SLURM_JOB_ID}.csv"
echo "timestamp,gpu_index,utilization_percent,memory_used_MB,memory_total_MB" > "$GPU_LOG"
(
    while true; do
        nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total \
            --format=csv,noheader,nounits >> "$GPU_LOG"
        sleep 60
    done
) &
GPU_MONITOR_PID=$!
trap 'kill "$GPU_MONITOR_PID" 2>/dev/null || true' EXIT

python twenty_questions_pilot.py \
    --repeats 1 \
    --results-file results/tesla1-qwen3-8b-gemma3-12b-mistral-nemo-granite33-r1.jsonl

echo "Job finished at $(date)"
