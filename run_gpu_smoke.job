#!/bin/bash
#SBATCH --job-name=20q-gpu-smoke
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err
#SBATCH --time=00-02:00
#SBATCH --mem=16000
#SBATCH --cpus-per-task=2
#SBATCH --gres=gpu:1

set -euo pipefail
cd "$SLURM_SUBMIT_DIR"

module load pytorch-cuda12
source "$HOME/.venvs/llmat20qs/bin/activate"

echo "GPU smoke game started on $(hostname) at $(date)"
nvidia-smi

GPU_LOG="logs/gpu_usage-${SLURM_JOB_ID}.csv"
echo "timestamp,gpu_index,utilization_percent,memory_used_MB,memory_total_MB" > "$GPU_LOG"
(
    while true; do
        nvidia-smi --query-gpu=timestamp,index,utilization.gpu,memory.used,memory.total \
            --format=csv,noheader,nounits >> "$GPU_LOG"
        sleep 60
    done
) &
GPU_MONITOR_PID=$!
trap 'kill "$GPU_MONITOR_PID" 2>/dev/null || true' EXIT

python - <<'PY'
import json
import os
from pathlib import Path

import torch
import twenty_questions_pilot as runner

if not torch.cuda.is_available():
    raise RuntimeError("SLURM did not expose a GPU to PyTorch")

model = next(model for model in runner.MODELS if model.get("backend") == "transformers")
print(f"Running one self-play game with {model['name']} on {torch.cuda.get_device_name(0)}")
runner.prepare_hf_pair(model)
game = runner.play(
    model,
    model,
    "banana",
    game_id=f"gpu-smoke-{os.environ['SLURM_JOB_ID']}|{model['name']}|banana",
)

output = Path(f"results/gpu-smoke-{os.environ['SLURM_JOB_ID']}.jsonl")
with output.open("w", encoding="utf-8") as results:
    results.write(json.dumps(game) + "\n")

print(f"Saved one game ({game['turns_used']} turns; won={game['won']}) to {output}")
PY

echo "GPU smoke game finished at $(date)"
